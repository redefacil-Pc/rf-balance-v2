# Copie para .env e ajuste. NUNCA versione o .env.
# Em produção estes valores vêm do secret manager, não deste arquivo.

# ---------- aplicação ----------
APP_ENV=local
APP_TIMEZONE=America/Sao_Paulo
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- portas expostas no host (só local) ----------
# Escolhidas para não colidir com o que já roda nesta máquina:
#   3306 = MySQL do sistema atual (v1), que não deve ser tocado
#   6379 / 9000 / 9001 = outro projeto local (workflow)
# Só afetam o acesso a partir do host; entre containers os nomes de serviço e as
# portas padrão continuam valendo.
DB_HOST_PORT=3307
REDIS_HOST_PORT=6380
MINIO_HOST_PORT=9100
MINIO_CONSOLE_HOST_PORT=9101
API_HOST_PORT=8000
WEB_HOST_PORT=5173

# ---------- banco ----------
# conta da aplicação: privilégio mínimo (sem DDL)
DATABASE_URL=mysql+asyncmy://rfbalance:rfbalance@db:3306/rfbalance
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false

# conta de migração: privilégio de DDL, usada só pelo Alembic
MIGRATION_DATABASE_URL=mysql+asyncmy://rfbalance_migrator:rfbalance_migrator@db:3306/rfbalance

# credenciais do container de MySQL local (não existe em produção)
MYSQL_ROOT_PASSWORD=troque-em-local
MYSQL_DATABASE=rfbalance
MYSQL_USER=rfbalance
MYSQL_PASSWORD=rfbalance

# ---------- redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- object storage ----------
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=rfbalance-documents
OBJECT_STORAGE_ACCESS_KEY=rfbalance
OBJECT_STORAGE_SECRET_KEY=troque-em-local
OBJECT_STORAGE_REGION=us-east-1
# MinIO local usa path. No DigitalOcean Spaces, use virtual.
OBJECT_STORAGE_ADDRESSING_STYLE=path

# ---------- segurança ----------
# distinta por ambiente; gerar com: openssl rand -hex 32
SECRET_KEY=troque-em-local-gerar-com-openssl-rand-hex-32

# ADR-0003: sessão em cookie HttpOnly com token opaco e rotação.
# Não há JWT — as variáveis JWT_* do blueprint deixaram de ser necessárias.
SESSION_TTL=1209600
SESSION_ROTATION_INTERVAL=900
SESSION_CACHE_TTL=60
COOKIE_SECURE=false
COOKIE_DOMAIN=

# rate limit do login (seção 13.1)
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW=900

# ---------- PII (ADR-0012) ----------
# Distintas do SECRET_KEY. Em local, ficam vazias e a aplicação usa chaves de
# desenvolvimento; fora de local são obrigatórias (fail-fast no startup).
# Gerar a chave: openssl rand -base64 32
# ATENÇÃO: trocar o pepper invalida todos os hashes de busca e exige recomputá-los.
PII_ENCRYPTION_KEY=
PII_HASH_PEPPER=

# ---------- observabilidade ----------
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# ---------- backup ----------
BACKUP_BUCKET=
BACKUP_RETENTION_DAYS=30

# ---------- contas iniciais do seed ----------
# Definidas: o seed recria a conta sempre com esta senha e não exige troca no
# primeiro acesso, o que torna `make reset` repetível.
# Vazias: o seed gera uma senha aleatória e a imprime uma única vez.
# LIDERANCA e CONSULTOR só são criadas quando a senha correspondente existe.
SEED_ADMIN_PASSWORD=

# Só o administrador nasce por padrão. As contas abaixo são criadas apenas
# quando a variável existe — e pela *presença* dela, mesmo vazia, então
# descomentar já basta para criá-las no próximo seed. Deixe assim para começar
# com o sistema vazio e cadastrar as pessoas pela tela, que é o fluxo real.
# SEED_FINANCEIRO_PASSWORD=
# SEED_OPERACIONAL_PASSWORD=
# SEED_LIDERANCA_PASSWORD=
# SEED_CONSULTOR_PASSWORD=
